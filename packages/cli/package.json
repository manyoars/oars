{
  "name": "@manyoars/oars",
  "version": "0.4.0",
  "description": "A local, searchable record of your coding agent sessions. Reads Claude Code, Cursor, Codex, Copilot CLI, Gemini CLI, and more, and keeps the record on your machine.",
  "homepage": "https://manyoars.com/",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "coding-agents",
    "agent-memory",
    "session-history",
    "mcp",
    "mcp-server",
    "claude-code-plugin",
    "codex-plugin",
    "gemini-cli-extension",
    "coding-agent",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manyoars/oars.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "bin": {
    "oars": "./dist/bin.js",
    "oars-hook": "./dist/oars-hook.js"
  },
  "files": [
    "dist",
    "vocab"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@manyoars/oars-client": "^0.1.1",
    "commander": "^15.0.0",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "msw": "^3.0.3",
    "typescript": "~5.9.3"
  }
}
