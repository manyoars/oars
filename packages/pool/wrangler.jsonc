// The pool's Cloudflare target. It holds no account id, resource id, secret, route, or custom domain: those belong to the deploy (docs/pool.md).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "oars-pool",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // The pool answers only on the custom domain the deploy attaches. The WAF rate rule on login and telemetry is a zone rule, and a zone rule does not run on the Worker's workers-dot-dev address or on a preview URL, so leaving either on would bypass it.
  "workers_dev": false,
  "preview_urls": false,
  // The serve floors, as plain variables because a floor is public: how many clusters a cell needs to be served (5), and how many must hold a signature's hash before its text may be requested (2). A deploy changes
  // them here or in its own copy of this file, and a change is a deploy and never a client release. `PUBLIC_FLOOR_FAMILIES` (`live=3,tool-day=8`) gives single read families a floor of their own; unset, none does.
  // The two OAuth client IDs the pool starts a provider's device flow with (docs/pool.md, "Sign-in"). A client ID is public; Google's client secret is not, and is the Worker secret `GOOGLE_CLIENT_SECRET`, declared here by name only.
  "vars": {
    "PUBLIC_FLOOR": "5",
    "DISCLOSURE_FLOOR": "2",
    "GITHUB_CLIENT_ID": "Ov23liKTHzJPQeVimbnO",
    "GOOGLE_CLIENT_ID": "146886627173-pcmp8t0qg6p4n0t4cnr4236oit43eudn.apps.googleusercontent.com"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "oars-pool", "migrations_dir": "migrations" }],
  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "oars-pool-raw" },
    { "binding": "TELEMETRY", "bucket_name": "oars-telemetry" }
  ],
  "analytics_engine_datasets": [{ "binding": "TELEMETRY_EVENTS", "dataset": "oars_telemetry" }],
  // Once a night: roll the telemetry record up into the table the fleet read comes from (docs/pool.md, "Telemetry rollup").
  "triggers": { "crons": ["17 3 * * *"] }
}
