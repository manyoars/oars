// The pool's Cloudflare target. It holds no account id, resource id, secret, route, or custom domain: those belong to the deploy (docs/pool.md).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "oars-pool",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "oars-pool", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "TELEMETRY", "bucket_name": "oars-telemetry" }],
  "analytics_engine_datasets": [{ "binding": "TELEMETRY_EVENTS", "dataset": "oars_telemetry" }],
  // Once a night: roll the telemetry record up into the table the fleet read comes from (docs/pool.md, "Telemetry rollup").
  "triggers": { "crons": ["17 3 * * *"] }
}
