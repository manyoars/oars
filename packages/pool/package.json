{
  "name": "@manyoars/pool",
  "version": "0.0.0",
  "private": true,
  "description": "The Many Oars pool: a Cloudflare Worker that takes closed-vocabulary session skeletons, redacted raw copies, and CLI telemetry, and serves signed reads",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "erase": "node scripts/erase.mjs",
    "pull-deposits": "node scripts/pull-deposits.mjs",
    "sample-pack": "node scripts/sample-pack.mjs",
    "real-work-table": "node scripts/real-work-table.mjs",
    "real-work-note": "node scripts/real-work-note.mjs",
    "deliver": "node scripts/deliver.mjs",
    "license-status": "node scripts/license-status.mjs",
    "notices": "node scripts/notices.mjs",
    "validate-pack": "node scripts/validate-pack.mjs",
    "grant-standing": "node scripts/grant-standing.mjs",
    "grant-crew": "node scripts/grant-crew.mjs",
    "hide-nickname": "node scripts/hide-nickname.mjs",
    "dev": "wrangler dev --port 8788"
  },
  "devDependencies": {
    "aws4fetch": "1.0.20",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.12.0",
    "miniflare": "5.20261104.0-beta",
    "typescript": "~5.9.3",
    "undici": "7.30.1",
    "wrangler": "4.158.0"
  }
}
