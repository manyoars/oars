{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "oars",
  "version": "0.5.6",
  "description": "Recall from your own past coding agent sessions, kept on your machine, over MCP.",
  "author": { "name": "Many Oars" },
  "homepage": "https://manyoars.com/",
  "repository": "https://github.com/manyoars/oars",
  "license": "Apache-2.0",
  "keywords": ["session-history", "agent-memory", "mcp"],
  "extensions": {
    "com.openai": {
      "hooks": {
        "hooks": {
          "SessionStart": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "oars-hook session-start --harness codex",
                  "timeout": 5
                }
              ]
            }
          ],
          "UserPromptSubmit": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "oars-hook prompt --harness codex",
                  "timeout": 5
                }
              ]
            }
          ],
          "PreToolUse": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "oars-hook pre-tool --harness codex",
                  "timeout": 5
                }
              ]
            }
          ],
          "PostToolUse": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "oars-hook post-tool --harness codex",
                  "timeout": 5
                }
              ]
            }
          ]
        }
      }
    }
  }
}
